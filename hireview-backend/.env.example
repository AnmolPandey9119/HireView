# Copy this file to .env and fill in real values. Never commit the real .env file.

# Groq API key — get one free at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Gemini API key (fallback for Groq + primary for feedback generation) —
# get one free at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Razorpay keys — from Dashboard -> Account & Settings -> API keys & integration
# Use TEST mode keys for development, LIVE keys only in production.
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Razorpay webhook secret — from Dashboard -> Account & Settings -> Webhooks
# -> Add New Webhook. Set the webhook URL to:
#   https://<your-backend-url>/api/payments/webhook
# Subscribe it to the "payment.captured" event, then copy the secret shown
# there (this is DIFFERENT from RAZORPAY_KEY_SECRET above).
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# Used to sign JWT tokens. Generate a real random value for production,
# e.g. `python -c "import secrets; print(secrets.token_hex(32))"`
SECRET_KEY=change_this_to_a_random_secret

# Your deployed Vercel frontend URL (optional — *.vercel.app is already allowed)
FRONTEND_URL=

# Brevo (for OTP emails) — get a key at https://app.brevo.com under
# SMTP & API -> API Keys. BREVO_SENDER_EMAIL must be a sender you've
# verified in Brevo (Senders, Domains & Dedicated IPs -> Senders).
BREVO_API_KEY=
BREVO_SENDER_EMAIL=no-reply@yourdomain.com
BREVO_SENDER_NAME=HireView

# Local dev only
DEBUG=True
PORT=8000